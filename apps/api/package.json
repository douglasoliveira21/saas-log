{
  "name": "@distribuihub/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start:watch": "tsc -p tsconfig.build.json --watch",
    "prisma:generate": "prisma generate",
    "db:setup": "tsx scripts/db-setup.ts",
    "platform-admin": "tsx scripts/platform-admin.ts",
    "backup": "tsx scripts/backup.ts backup",
    "restore:check": "tsx scripts/backup.ts restore-check",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest --config jest.config.js --testPathPattern=src",
    "test:e2e": "tsx scripts/db-setup.ts --test && jest --config jest.config.js --testPathPattern=test --runInBand",
    "fiscal:schemas": "tsx scripts/fiscal-schemas.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "@xmldom/xmldom": "^0.8.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "^4.5.7",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "jsbarcode": "^3.11.6",
    "node-forge": "^1.3.1",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xml-crypto": "^6.4.0",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
