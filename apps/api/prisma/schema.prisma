// DistribuiHub ERP — modelo de dados (Fase 1: fundação).
// Regras gerais:
//  - Toda tabela de negócio carrega tenant_id e é protegida por Row-Level Security (ver migration 0002).
//  - Sem exclusão física de registros rastreáveis: usamos status/active.
//  - Tabelas globais (sem RLS): plans, users, refresh_sessions. Ver docs/MULTITENANCY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum EstablishmentKind {
  MATRIZ
  FILIAL
  CENTRO_DISTRIBUICAO
}

enum WarehouseKind {
  PROPRIO
  TERCEIROS
  CONSIGNADO
}

// ───────────────────────── Globais ─────────────────────────

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  limits      Json     @default("{}")
  active      Boolean  @default(true)
  priceCents  Int?     @map("price_cents")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique // sempre minúsculo (normalizado na aplicação)
  name             String
  phone            String?
  /// Estilo de navegação do usuário: CLASSIC (menu lateral) ou LAUNCHER (início em blocos, sem menu lateral).
  navStyle         String     @default("CLASSIC") @map("nav_style")
  passwordHash     String     @map("password_hash")
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  lastLoginAt      DateTime?  @map("last_login_at")
  /// Segundo fator (TOTP): segredo cifrado; só vale depois de totpEnabledAt. recoveryCodes = hashes (sha256) dos códigos de uso único.
  totpSecret       String?    @map("totp_secret")
  totpEnabledAt    DateTime?  @map("totp_enabled_at")
  recoveryCodes    Json?      @map("recovery_codes")
  createdAt        DateTime   @default(now()) @map("created_at")

  memberships Membership[]
  sessions    RefreshSession[]
  avatar      UserAvatar?

  @@map("users")
}

// Sessões de refresh: guardamos somente o hash do token opaco.
model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

// ───────────────────────── Tenant e acesso ─────────────────────────

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  status      TenantStatus @default(TRIAL)
  planId      String?      @map("plan_id") @db.Uuid
  trialEndsAt DateTime?    @map("trial_ends_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  plan                   Plan?                   @relation(fields: [planId], references: [id])
  memberships            Membership[]
  roles                  Role[]
  companies              Company[]
  establishments         Establishment[]
  warehouses             Warehouse[]
  auditLogs              AuditLog[]
  productCategories      ProductCategory[]
  products               Product[]
  suppliers              Supplier[]
  customers              Customer[]
  salespeople            Salesperson[]
  commissionRules        CommissionRule[]
  salesOrders            SalesOrder[]
  purchaseOrders         PurchaseOrder[]
  marketplaceConnections MarketplaceConnection[]
  backgroundJobs         BackgroundJob[]
  subscriptions          Subscription[]
  branding               TenantBranding?

  @@map("tenants")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships Membership[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@id([roleId, permission])
  @@index([tenantId])
  @@map("role_permissions")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// ───────────────────────── Estrutura da empresa ─────────────────────────
// Empresa (pessoa jurídica) ≠ Estabelecimento (CNPJ/IE) ≠ Depósito (local físico de estoque)
// ≠ Canal de venda (Fase 4+). Endereço é embutido por ora (ADR-0003).

model Company {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  legalName    String     @map("legal_name")
  tradeName    String?    @map("trade_name")
  cnpj         String?
  taxRegime    TaxRegime? @map("tax_regime")
  contactEmail String?    @map("contact_email")
  contactPhone String?    @map("contact_phone")
  responsible  String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  establishments Establishment[]

  @@unique([tenantId, cnpj])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("companies")
}

model Establishment {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  companyId             String            @map("company_id") @db.Uuid
  kind                  EstablishmentKind @default(MATRIZ)
  name                  String
  cnpj                  String?
  stateRegistration     String?           @map("state_registration")
  municipalRegistration String?           @map("municipal_registration")
  cnae                  String?
  zipCode               String?           @map("zip_code")
  street                String?
  number                String?
  complement            String?
  district              String?
  city                  String?
  state                 String?           @db.Char(2)
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  company             Company              @relation(fields: [tenantId, companyId], references: [tenantId, id])
  warehouses          Warehouse[]
  fiscalConfiguration FiscalConfiguration?
  fiscalCertificates  FiscalCertificate[]

  @@unique([tenantId, cnpj])
  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@map("establishments")
}

model Warehouse {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  code            String
  name            String
  kind            WarehouseKind @default(PROPRIO)
  zipCode         String?       @map("zip_code")
  street          String?
  number          String?
  district        String?
  city            String?
  state           String?       @db.Char(2)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  establishment          Establishment           @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
  stockBalances          StockBalance[]
  stockLots              StockLot[]
  locations              WarehouseLocation[]
  stockMovements         StockMovement[]
  stockReservations      StockReservation[]
  inventoryCounts        InventoryCount[]
  salesOrders            SalesOrder[]
  purchaseOrders         PurchaseOrder[]
  marketplaceConnections MarketplaceConnection[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, establishmentId])
  @@map("warehouses")
}

// ───────────────────────── Auditoria ─────────────────────────
// Append-only: o papel de runtime só possui INSERT/SELECT (migration 0002).

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

// ───────────────────────── Fase 2: catálogo, fornecedores e estoque ─────────────────────────

enum ProductKind {
  PHYSICAL
  KIT
  SET
  VARIATION
}

enum MovementType {
  PURCHASE_ENTRY
  SALE_EXIT
  RETURN_ENTRY
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  LOSS
  DAMAGE
  INTERNAL_USE
  REVERSAL
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum CountStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  products                Product[]
  channelCategoryMappings ChannelCategoryMapping[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("product_categories")
}

model Product {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  sku              String
  barcode          String?
  name             String
  shortDescription String?     @map("short_description")
  description      String?
  brand            String?
  manufacturer     String?
  model            String?
  categoryId       String?     @map("category_id") @db.Uuid
  saleUnit         String      @default("UN") @map("sale_unit")
  purchaseUnit     String      @default("UN") @map("purchase_unit")
  unitConversion   Int         @default(1) @map("unit_conversion")
  netWeightG       Int?        @map("net_weight_g")
  grossWeightG     Int?        @map("gross_weight_g")
  heightMm         Int?        @map("height_mm")
  widthMm          Int?        @map("width_mm")
  lengthMm         Int?        @map("length_mm")
  kind             ProductKind @default(PHYSICAL)
  active           Boolean     @default(true)
  costPrice        Decimal?    @map("cost_price") @db.Decimal(14, 4)
  extraCost        Decimal?    @map("extra_cost") @db.Decimal(14, 4)
  /// Preço de varejo (tabela padrão).
  suggestedPrice   Decimal?    @map("suggested_price") @db.Decimal(14, 2)
  /// Preço de atacado (tabela de atacado); vazio = vende pelo preço de varejo.
  wholesalePrice   Decimal?    @map("wholesale_price") @db.Decimal(14, 2)
  minPrice         Decimal?    @map("min_price") @db.Decimal(14, 2)
  targetMarginPct  Decimal?    @map("target_margin_pct") @db.Decimal(6, 2)
  minStock         Int         @default(0) @map("min_stock")
  /// Controle de lote e validade (PEPS/FEFO): entradas exigem lote e as saídas consomem o que vence primeiro.
  trackLots        Boolean     @default(false) @map("track_lots")
  maxStock         Int?        @map("max_stock")
  reorderPoint     Int?        @map("reorder_point")
  leadTimeDays     Int?        @map("lead_time_days")
  locationNote     String?     @map("location_note")
  // Fiscal: nunca preenchido automaticamente; ausência = pendência.
  ncm              String?
  cest             String?
  taxOrigin        Int?        @map("tax_origin")
  taxUnit          String?     @map("tax_unit")
  taxGtin          String?     @map("tax_gtin")
  // Dados de anúncio (padrão de marketplace): título comercial, condição, garantia, código do fabricante e ficha técnica.
  title            String?
  condition        String      @default("NEW") // NEW | USED | REFURBISHED
  warrantyMonths   Int?        @map("warranty_months")
  mpn              String?
  attributes       Json        @default("[]") // [{ name, value }]
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  category            ProductCategory?     @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  suppliers           ProductSupplier[]
  balances            StockBalance[]
  movements           StockMovement[]
  reservations        StockReservation[]
  countItems          InventoryCountItem[]
  salesOrderItems     SalesOrderItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  channelListings     ChannelListing[]
  fiscalDocumentItems FiscalDocumentItem[]
  images              ProductImage[]
  channelItems        ChannelItem[]
  quoteItems QuoteItem[]
  rfqItems RfqItem[]
  stockLots StockLot[]
  locationItems StockLocationItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("products")
}

model Supplier {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  legalName         String   @map("legal_name")
  tradeName         String?  @map("trade_name")
  document          String?
  stateRegistration String?  @map("state_registration")
  email             String?
  phone             String?
  paymentTerms      String?  @map("payment_terms")
  leadTimeDays      Int?     @map("lead_time_days")
  notes             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  products        ProductSupplier[]
  purchaseOrders  PurchaseOrder[]
  fiscalDocuments FiscalDocument[]
  rfqSuppliers RfqSupplier[]

  @@unique([tenantId, document])
  @@unique([tenantId, id])
  @@map("suppliers")
}

model ProductSupplier {
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  supplierSku String?  @map("supplier_sku")
  lastPrice   Decimal? @map("last_price") @db.Decimal(14, 4)
  isMain      Boolean  @default(false) @map("is_main")

  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id])
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id])

  @@id([productId, supplierId])
  @@index([tenantId])
  @@map("product_suppliers")
}

// Saldo por produto × depósito. disponível = on_hand − reserved − blocked (regra única em StockService).
model StockBalance {
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  blocked     Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id])
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  @@id([productId, warehouseId])
  @@index([tenantId, warehouseId])
  @@map("stock_balances")
}

// Razão imutável: o papel de runtime só tem INSERT/SELECT. Correção = novo movimento (REVERSAL).
model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  type           MovementType
  quantity       Int
  balanceBefore  Int          @map("balance_before")
  balanceAfter   Int          @map("balance_after")
  reason         String?
  reference      String?
  idempotencyKey String?      @map("idempotency_key")
  reversalOfId   String?      @unique @map("reversal_of_id") @db.Uuid
  transferId     String?      @map("transfer_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id])
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  quantity       Int
  status         ReservationStatus @default(ACTIVE)
  reference      String?
  idempotencyKey String            @map("idempotency_key")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  resolvedAt     DateTime?         @map("resolved_at")

  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id])
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("stock_reservations")
}

model InventoryCount {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  warehouseId  String      @map("warehouse_id") @db.Uuid
  name         String
  status       CountStatus @default(OPEN)
  createdById  String?     @map("created_by_id") @db.Uuid
  resolvedById String?     @map("resolved_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  submittedAt  DateTime?   @map("submitted_at")
  resolvedAt   DateTime?   @map("resolved_at")

  warehouse Warehouse            @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  items     InventoryCountItem[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  tenantId   String @map("tenant_id") @db.Uuid
  countId    String @map("count_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  systemQty  Int    @map("system_qty")
  countedQty Int?   @map("counted_qty")

  count   InventoryCount @relation(fields: [tenantId, countId], references: [tenantId, id])
  product Product        @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@id([countId, productId])
  @@map("inventory_count_items")
}

// ───────────────────────── Fase 3: clientes, vendas, compras e comissões ─────────────────────────

enum CustomerKind {
  PF
  PJ
}

enum SalesChannel {
  DIRECT
  PHONE
  WHATSAPP
  EMAIL
  STORE
  WEB
  REPRESENTATIVE
  MARKETPLACE
}

/// Documento fiscal escolhido na venda: nenhum (decidir depois), NF-e (modelo 55) ou NFC-e (cupom do consumidor, modelo 65).
enum FiscalDocChoice {
  NONE
  NFE
  NFCE
}

/// Perfil do cliente no momento da compra: primeira compra, cliente ativo ou cliente que voltou após o período de inatividade.
enum CustomerPurchaseType {
  NEW
  ACTIVE
  RETURNING
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CLOSED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  POSTED
  REVERSED
}

enum CommissionRuleKind {
  PERCENT
  FIXED_PER_UNIT
}

enum CommissionEntryKind {
  ACCRUAL
  REVERSAL
}

enum CommissionStatus {
  FORECAST
  EARNED
  PAID
}

model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([tenantId, key])
  @@map("tenant_settings")
}

model DocumentCounter {
  tenantId String @map("tenant_id") @db.Uuid
  kind     String
  last     Int    @default(0)

  @@id([tenantId, kind])
  @@map("document_counters")
}

model Customer {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  kind              CustomerKind
  name              String
  document          String?
  stateRegistration String?      @map("state_registration")
  email             String?
  phone             String?
  /// Cliente que pediu para não receber avisos automáticos (e-mail/WhatsApp).
  /// Tabela de preço padrão deste cliente nas vendas: RETAIL (varejo) ou WHOLESALE (atacado).
  priceTable        String       @default("RETAIL") @map("price_table")
  /// Carteira de clientes: vendedor responsável por este cliente.
  salespersonId     String?      @map("salesperson_id") @db.Uuid
  notifyOptOut      Boolean      @default(false) @map("notify_opt_out")
  zipCode           String?      @map("zip_code")
  street            String?
  number            String?
  district          String?
  city              String?
  state             String?      @db.Char(2)
  active            Boolean      @default(true)
  /// Liberação manual do bloqueio por inadimplência (vale até a data informada).
  blockReleasedUntil  DateTime?  @map("block_released_until")
  blockReleaseReason  String?    @map("block_release_reason")
  blockReleasedById   String?    @map("block_released_by_id") @db.Uuid
  /// Limite de crédito para vendas a prazo (boleto, cheque); nulo = sem controle.
  creditLimit       Decimal?     @map("credit_limit") @db.Decimal(14, 2)
  /// Validade mínima (dias restantes) dos lotes entregues a este cliente; nulo = qualquer lote dentro da validade.
  minShelfLifeDays  Int?         @map("min_shelf_life_days")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  orders SalesOrder[]
  negotiations Negotiation[]
  quotes Quote[]

  @@unique([tenantId, document])
  @@unique([tenantId, id])
  portfolioOwner Salesperson? @relation("CustomerPortfolio", fields: [tenantId, salespersonId], references: [tenantId, id])

  @@map("customers")
}

model Salesperson {
  portfolio Customer[] @relation("CustomerPortfolio")
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  userId       String?  @map("user_id") @db.Uuid
  employment   String   @default("EMPLOYEE")
  supervisorId String?  @map("supervisor_id") @db.Uuid
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  orders      SalesOrder[]
  rules       CommissionRule[]
  commissions SalesCommission[]
  goals       SalesGoal[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("salespeople")
}

model CommissionRule {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  name          String
  salespersonId String?            @map("salesperson_id") @db.Uuid
  categoryId    String?            @map("category_id") @db.Uuid
  productId     String?            @map("product_id") @db.Uuid
  customerId    String?            @map("customer_id") @db.Uuid
  channel       SalesChannel?
  kind          CommissionRuleKind
  percent       Decimal?           @db.Decimal(7, 4)
  fixedAmount   Decimal?           @map("fixed_amount") @db.Decimal(14, 2)
  priority      Int                @default(0)
  validFrom     DateTime?          @map("valid_from")
  validTo       DateTime?          @map("valid_to")
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  salesperson Salesperson? @relation(fields: [tenantId, salespersonId], references: [tenantId, id])

  @@index([tenantId, active])
  @@map("commission_rules")
}

model SalesOrder {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  number         Int
  customerId     String       @map("customer_id") @db.Uuid
  salespersonId  String?      @map("salesperson_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  channel        SalesChannel @default(DIRECT)
  fiscalDocType  FiscalDocChoice @default(NONE) @map("fiscal_doc_type")
  /// Data prevista de saída (vendas fora de marketplace, com horário de corte configurado), definida na confirmação.
  dispatchDate   DateTime?    @map("dispatch_date") @db.Date
  /// Verdadeiro quando a saída ficou para depois do dia da venda (passou do corte ou caiu em fim de semana).
  dispatchDeferred Boolean    @default(false) @map("dispatch_deferred")
  customerType   CustomerPurchaseType? @map("customer_type")
  /// Forma de pagamento: CASH | PIX | DEBIT | CREDIT | BOLETO | CHECK | OTHER. Boleto exige parcelas e 1º vencimento; ao confirmar, gera as contas a receber.
  paymentMethod  String?      @map("payment_method")
  /// Tabela de preço usada nesta venda: RETAIL (varejo) ou WHOLESALE (atacado).
  priceTable     String       @default("RETAIL") @map("price_table")
  installmentCount Int        @default(1) @map("installment_count")
  firstDueDate   DateTime?    @map("first_due_date") @db.Date
  installmentIntervalDays Int @default(30) @map("installment_interval_days")
  /// Identificador do app de venda em campo (idempotência do envio offline).
  clientRef      String?      @map("client_ref")
  status         OrderStatus  @default(DRAFT)
  subtotal       Decimal      @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal      @default(0) @map("discount_total") @db.Decimal(14, 2)
  shipping       Decimal      @default(0) @db.Decimal(14, 2)
  total          Decimal      @default(0) @db.Decimal(14, 2)
  notes          String?
  approvalReason String?      @map("approval_reason")
  cancelReason   String?      @map("cancel_reason")
  externalSource String?      @map("external_source")
  externalRef    String?      @map("external_ref")
  createdById    String?      @map("created_by_id") @db.Uuid
  approvedById   String?      @map("approved_by_id") @db.Uuid
  confirmedAt    DateTime?    @map("confirmed_at")
  /// Expedição: quando e por quem a separação começou e o pedido foi embalado; urgência e observação da expedição.
  pickingStartedAt DateTime?  @map("picking_started_at")
  pickingById    String?      @map("picking_by_id") @db.Uuid
  packedAt       DateTime?    @map("packed_at")
  packedById     String?      @map("packed_by_id") @db.Uuid
  rush           Boolean      @default(false)
  rushReason     String?      @map("rush_reason")
  fulfillmentNote String?     @map("fulfillment_note")
  shippedAt      DateTime?    @map("shipped_at")
  deliveredAt    DateTime?    @map("delivered_at")
  cancelledAt    DateTime?    @map("cancelled_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  customer        Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id])
  salesperson     Salesperson?      @relation(fields: [tenantId, salespersonId], references: [tenantId, id])
  warehouse       Warehouse         @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  items           SalesOrderItem[]
  returns         ReturnRequest[]
  commissions     SalesCommission[]
  externalOrders  ExternalOrder[]
  fiscalDocuments FiscalDocument[]
  shipments       Shipment[]
  deliveryStops   DeliveryStop[]
  checks          OrderCheck[]

  @@unique([tenantId, number])
  @@unique([tenantId, externalSource, externalRef])
  @@unique([tenantId, clientRef])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountPct   Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  total         Decimal  @db.Decimal(14, 2)
  costSnapshot  Decimal? @map("cost_snapshot") @db.Decimal(14, 4)
  reservationId String?  @map("reservation_id") @db.Uuid

  order       SalesOrder   @relation(fields: [tenantId, orderId], references: [tenantId, id])
  product     Product      @relation(fields: [tenantId, productId], references: [tenantId, id])
  returnItems ReturnItem[]

  @@unique([orderId, productId])
  @@unique([tenantId, id])
  @@map("sales_order_items")
}

model ReturnRequest {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  reason      String
  restock     Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  order SalesOrder   @relation(fields: [tenantId, orderId], references: [tenantId, id])
  items ReturnItem[]

  @@unique([tenantId, id])
  @@map("return_requests")
}

model ReturnItem {
  tenantId    String @map("tenant_id") @db.Uuid
  returnId    String @map("return_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  request   ReturnRequest  @relation(fields: [tenantId, returnId], references: [tenantId, id])
  orderItem SalesOrderItem @relation(fields: [tenantId, orderItemId], references: [tenantId, id])

  @@id([returnId, orderItemId])
  @@map("return_items")
}

// Livro de comissões: nunca apagamos; cancelamentos/devoluções entram como REVERSAL (valor negativo).
model SalesCommission {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  orderId       String              @map("order_id") @db.Uuid
  orderItemId   String?             @map("order_item_id") @db.Uuid
  salespersonId String              @map("salesperson_id") @db.Uuid
  ruleId        String?             @map("rule_id") @db.Uuid
  returnId      String?             @map("return_id") @db.Uuid
  kind          CommissionEntryKind
  status        CommissionStatus
  base          Decimal             @db.Decimal(14, 2)
  amount        Decimal             @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime            @default(now()) @map("created_at")
  earnedAt      DateTime?           @map("earned_at")
  paidAt        DateTime?           @map("paid_at")
  payoutTitleId String?             @map("payout_title_id") @db.Uuid

  order       SalesOrder  @relation(fields: [tenantId, orderId], references: [tenantId, id])
  salesperson Salesperson @relation(fields: [tenantId, salespersonId], references: [tenantId, id])

  @@index([tenantId, salespersonId, status])
  @@index([tenantId, orderId])
  @@map("sales_commissions")
}

model PurchaseOrder {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  number       Int
  supplierId   String         @map("supplier_id") @db.Uuid
  warehouseId  String         @map("warehouse_id") @db.Uuid
  status       PurchaseStatus @default(DRAFT)
  expectedDate DateTime?      @map("expected_date")
  freight      Decimal        @default(0) @db.Decimal(14, 2)
  total        Decimal        @default(0) @db.Decimal(14, 2)
  notes        String?
  createdById  String?        @map("created_by_id") @db.Uuid
  approvedById String?        @map("approved_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  supplier  Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  warehouse Warehouse           @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  qtyOrdered  Int     @map("qty_ordered")
  qtyReceived Int     @default(0) @map("qty_received")
  unitCost    Decimal @map("unit_cost") @db.Decimal(14, 4)

  order   PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id])
  product Product       @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([orderId, productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  purchaseId     String        @map("purchase_id") @db.Uuid
  status         ReceiptStatus @default(POSTED)
  note           String?
  idempotencyKey String?       @map("idempotency_key")
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  purchase PurchaseOrder      @relation(fields: [tenantId, purchaseId], references: [tenantId, id])
  items    GoodsReceiptItem[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  tenantId   String  @map("tenant_id") @db.Uuid
  receiptId  String  @map("receipt_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(14, 4)
  movementId String? @map("movement_id") @db.Uuid
  note       String?

  receipt GoodsReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id])
  product Product      @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@id([receiptId, productId])
  @@map("goods_receipt_items")
}

// ───────────────────────── Fase 4: central de integrações ─────────────────────────

enum ConnectionStatus {
  NOT_CONNECTED
  AWAITING_AUTHORIZATION
  TEST_PENDING
  INCOMPLETE_CONFIG
  CONNECTED
  ACTIVE
  PAUSED
  TOKEN_EXPIRED
  SYNC_ERROR
  DISCONNECTED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

// Credenciais (tokens) ficam somente em credentials_enc: AES-256-GCM com chave derivada por tenant.
model MarketplaceConnection {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  provider          String
  label             String
  status            ConnectionStatus @default(NOT_CONNECTED)
  externalAccountId String?          @map("external_account_id")
  warehouseId       String?          @map("warehouse_id") @db.Uuid
  config            Json             @default("{}")
  credentialsEnc    String?          @map("credentials_enc")
  webhookSecretEnc  String?          @map("webhook_secret_enc")
  oauthNonce        String?          @map("oauth_nonce")
  tokenExpiresAt    DateTime?        @map("token_expires_at")
  testedAt          DateTime?        @map("tested_at")
  lastSyncAt        DateTime?        @map("last_sync_at")
  lastError         String?          @map("last_error")
  createdById       String?          @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  warehouse               Warehouse?               @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  mappings                ExternalEntityMapping[]
  webhooks                WebhookEvent[]
  logs                    IntegrationLog[]
  jobs                    BackgroundJob[]
  externalOrders          ExternalOrder[]
  channelListings         ChannelListing[]
  channelItems            ChannelItem[]
  channelCategoryMappings ChannelCategoryMapping[]

  @@unique([tenantId, provider, externalAccountId])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("marketplace_connections")
}

model ExternalEntityMapping {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  entityType   String   @map("entity_type")
  internalId   String?  @map("internal_id") @db.Uuid
  externalId   String   @map("external_id")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  connection MarketplaceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id])

  @@unique([connectionId, entityType, externalId])
  @@index([tenantId, entityType, internalId])
  @@map("external_entity_mappings")
}

model WebhookEvent {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  connectionId String        @map("connection_id") @db.Uuid
  dedupeKey    String        @map("dedupe_key")
  eventType    String?       @map("event_type")
  payload      Json
  status       WebhookStatus @default(RECEIVED)
  error        String?
  receivedAt   DateTime      @default(now()) @map("received_at")
  processedAt  DateTime?     @map("processed_at")

  connection MarketplaceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id])

  @@unique([connectionId, dedupeKey])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("webhook_events")
}

// Append-only. Mensagens e metadados passam por remoção de segredos antes de gravar.
model IntegrationLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  connectionId String?  @map("connection_id") @db.Uuid
  level        String
  operation    String
  message      String
  statusCode   Int?     @map("status_code")
  durationMs   Int?     @map("duration_ms")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  connection MarketplaceConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id])

  @@index([tenantId, connectionId, createdAt])
  @@map("integration_logs")
}

// Fila durável no PostgreSQL (ADR-0006). Reivindicação cross-tenant por função SECURITY DEFINER.
model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  connectionId   String?   @map("connection_id") @db.Uuid
  type           String
  payload        Json      @default("{}")
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  runAt          DateTime  @default(now()) @map("run_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  result         Json?
  idempotencyKey String?   @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  finishedAt     DateTime? @map("finished_at")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  connection MarketplaceConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id])

  @@unique([tenantId, idempotencyKey])
  @@index([status, runAt])
  @@index([tenantId, connectionId, status])
  @@map("background_jobs")
}

// Livro das ordens vindas de canais: garante idempotência da importação e guarda o que precisa de atenção (SKU sem vínculo, estoque, etc.).
model ExternalOrder {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  externalId     String   @map("external_id")
  status         String // AWAITING_PAYMENT | IMPORTED | NEEDS_ATTENTION | CANCELLED
  externalStatus String?  @map("external_status")
  salesOrderId   String?  @map("sales_order_id") @db.Uuid
  reason         String?
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  connection MarketplaceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id])
  salesOrder SalesOrder?           @relation(fields: [tenantId, salesOrderId], references: [tenantId, id])

  @@unique([connectionId, externalId])
  @@index([tenantId, connectionId, status])
  @@map("external_orders")
}

// ───────────────────────── Fase 5b: anúncios, preços e categorias por canal ─────────────────────────

// Um produto do ERP publicado (ou a publicar) em uma conexão. O preço aqui é o preço APROVADO do canal.
model ChannelListing {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  connectionId       String    @map("connection_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  externalItemId     String?   @map("external_item_id")
  title              String?
  status             String    @default("DRAFT") // DRAFT | LINKED | PAUSED
  price              Decimal?  @db.Decimal(14, 2)
  lastPublishedPrice Decimal?  @map("last_published_price") @db.Decimal(14, 2)
  lastPublishedQty   Int?      @map("last_published_qty")
  syncStatus         String?   @map("sync_status") // OK | BLOCKED | ERROR
  syncError          String?   @map("sync_error")
  lastSyncAt         DateTime? @map("last_sync_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  connection MarketplaceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id])
  product    Product               @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([connectionId, productId])
  @@unique([connectionId, externalItemId])
  @@index([tenantId, connectionId])
  @@map("channel_listings")
}

// Histórico imutável de alterações de preço de canal.
model PriceHistory {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  oldPrice     Decimal? @map("old_price") @db.Decimal(14, 2)
  newPrice     Decimal  @map("new_price") @db.Decimal(14, 2)
  marginPct    Decimal? @map("margin_pct") @db.Decimal(7, 2)
  reason       String
  userId       String?  @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, productId, connectionId, createdAt])
  @@map("price_history")
}

// Categoria do ERP → categoria do canal. O identificador externo é informado pelo usuário (a consulta automática
// de categorias depende dos conectores reais).
model ChannelCategoryMapping {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  connectionId         String   @map("connection_id") @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  externalCategoryId   String   @map("external_category_id")
  externalCategoryName String?  @map("external_category_name")
  createdAt            DateTime @default(now()) @map("created_at")

  connection MarketplaceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id])
  category   ProductCategory       @relation(fields: [tenantId, categoryId], references: [tenantId, id])

  @@unique([connectionId, categoryId])
  @@map("channel_category_mappings")
}

// ───────────────────────── Fase 6: fiscal ─────────────────────────
// Princípios: nenhuma alíquota/regra tributária vem pré-cadastrada; regras são do tenant, versionadas, aprovadas e
// rastreáveis. Documentos e XML são imutáveis após registrados.

// Parâmetros fiscais por estabelecimento. A validação do contador é registrada (quem/quando).
model FiscalConfiguration {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  environment     String    @default("HOMOLOGACAO") // HOMOLOGACAO | PRODUCAO
  documentTypes   String[]  @default(["NFE"]) @map("document_types")
  nfeSeries       Int       @default(1) @map("nfe_series")
  accountantName  String?   @map("accountant_name")
  accountantEmail String?   @map("accountant_email")
  status          String    @default("DRAFT") // DRAFT | PENDING_ACCOUNTANT | APPROVED
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  notes           String?
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])

  @@unique([tenantId, establishmentId])
  @@map("fiscal_configurations")
}

// Certificado digital A1: arquivo e senha ficam cifrados (AES-256-GCM, chave por tenant); só metadados são expostos.
model FiscalCertificate {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  subject         String
  cnpj            String?
  serial          String
  fingerprint     String
  notBefore       DateTime @map("not_before")
  notAfter        DateTime @map("not_after")
  pfxEnc          String   @map("pfx_enc")
  status          String   @default("ACTIVE") // ACTIVE | REPLACED
  uploadedById    String?  @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, establishmentId, status])
  @@map("fiscal_certificates")
}

model FiscalDocument {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  direction       String // ENTRY | EXIT
  model           String    @default("55")
  status          String
  accessKey       String?   @map("access_key")
  series          Int?
  number          Int?
  environment     String? // HOMOLOGACAO | PRODUCAO (tpAmb do documento)
  issuedAt        DateTime? @map("issued_at")
  establishmentId String?   @map("establishment_id") @db.Uuid
  emitterDoc      String?   @map("emitter_doc")
  emitterName     String?   @map("emitter_name")
  emitterUf       String?   @map("emitter_uf")
  recipientDoc    String?   @map("recipient_doc")
  totalProducts   Decimal?  @map("total_products") @db.Decimal(14, 2)
  totalInvoice    Decimal?  @map("total_invoice") @db.Decimal(14, 2)
  totalFreight    Decimal?  @map("total_freight") @db.Decimal(14, 2)
  authProtocol    String?   @map("auth_protocol")
  authStatusCode  String?   @map("auth_status_code")
  authenticity    String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED (consulta SEFAZ / assinatura) — hoje sempre UNVERIFIED
  issues          Json      @default("[]")
  installments    Json      @default("[]")
  supplierId      String?   @map("supplier_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  receiptId       String?   @map("receipt_id") @db.Uuid
  salesOrderId    String?   @map("sales_order_id") @db.Uuid
  /// NORMAL | RETURN_SALE (NF-e de devolução de venda: entrada própria, finNFe 4, referencia a nota original).
  purpose         String    @default("NORMAL")
  refDocumentId   String?   @map("ref_document_id") @db.Uuid
  returnId        String?   @map("return_id") @db.Uuid
  /** NFC-e dividida pelo limite de valor do cupom: "cupom N de M" do mesmo pedido. */
  splitIndex      Int?      @map("split_index")
  splitTotal      Int?      @map("split_total")
  calculationId   String?   @map("calculation_id") @db.Uuid
  providerState   Json      @default("{}") @map("provider_state")
  importedById    String?   @map("imported_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  supplier   Supplier?            @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  salesOrder SalesOrder?          @relation(fields: [tenantId, salesOrderId], references: [tenantId, id])
  items      FiscalDocumentItem[]
  xmlFiles   FiscalXmlFile[]
  events     FiscalEvent[]

  @@unique([tenantId, accessKey])
  @@unique([tenantId, id])
  @@index([tenantId, direction, status])
  @@map("fiscal_documents")
}

model FiscalDocumentItem {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  documentId   String  @map("document_id") @db.Uuid
  line         Int
  supplierCode String? @map("supplier_code")
  gtin         String?
  description  String
  ncm          String?
  cfop         String?
  unit         String?
  quantity     Decimal @db.Decimal(14, 4)
  unitValue    Decimal @map("unit_value") @db.Decimal(14, 6)
  totalValue   Decimal @map("total_value") @db.Decimal(14, 2)
  declaredTax  Json    @default("{}") @map("declared_tax")
  productId    String? @map("product_id") @db.Uuid
  matchedBy    String? @map("matched_by") // SUPPLIER_CODE | GTIN | MANUAL
  stockQty     Int?    @map("stock_qty")

  document FiscalDocument @relation(fields: [tenantId, documentId], references: [tenantId, id])
  product  Product?       @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([documentId, line])
  @@map("fiscal_document_items")
}

// XML original, imutável (guarda de retenção). O hash prova que o conteúdo não foi alterado.
model FiscalXmlFile {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  kind        String   @default("RECEIVED") // RECEIVED | SIGNED | AUTHORIZED
  sha256      String
  content     String
  source      String? // origem: upload manual, nome do arquivo
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  document FiscalDocument @relation(fields: [tenantId, documentId], references: [tenantId, id])

  @@index([tenantId, documentId])
  @@map("fiscal_xml_files")
}

// Numeração por estabelecimento/série/ambiente, incrementada atomicamente (nunca reutiliza número).
model FiscalSeries {
  tenantId        String @map("tenant_id") @db.Uuid
  establishmentId String @map("establishment_id") @db.Uuid
  model           String @default("55")
  series          Int
  environment     String
  last            Int    @default(0)

  @@id([tenantId, establishmentId, model, series, environment])
  @@map("fiscal_series")
}

model TaxRule {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  operation     String // PURCHASE | SALE | RETURN_SALE | RETURN_PURCHASE | TRANSFER | OTHER
  originUf      String?  @map("origin_uf") @db.Char(2)
  destUf        String?  @map("dest_uf") @db.Char(2)
  ncmPrefix     String?  @map("ncm_prefix")
  regime        String?
  productOrigin Int?     @map("product_origin")
  recipientKind String?  @map("recipient_kind") // CONTRIBUINTE | NAO_CONTRIBUINTE
  priority      Int      @default(0)
  active        Boolean  @default(true)
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  versions TaxRuleVersion[]

  @@unique([tenantId, id])
  @@index([tenantId, operation, active])
  @@map("tax_rules")
}

model TaxRuleVersion {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  ruleId          String    @map("rule_id") @db.Uuid
  version         Int
  status          String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | SUPERSEDED
  validFrom       DateTime  @map("valid_from")
  validTo         DateTime? @map("valid_to")
  config          Json
  sourceReference String    @map("source_reference") // base legal / orientação do contador (obrigatório)
  createdById     String?   @map("created_by_id") @db.Uuid
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  rule TaxRule @relation(fields: [tenantId, ruleId], references: [tenantId, id])

  @@unique([ruleId, version])
  @@unique([tenantId, id])
  @@map("tax_rule_versions")
}

// Retrato reprodutível de um cálculo: entradas, saídas, versões de regra e versão do motor.
model TaxCalculation {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  operation      String
  engineVersion  String   @map("engine_version")
  inputs         Json
  outputs        Json
  ruleVersionIds String[] @map("rule_version_ids")
  pendencies     Json     @default("[]")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("tax_calculations")
}

// ───────────────────────── Fase 7: financeiro, relatórios e logística ─────────────────────────

model FinancialAccount {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  kind           String // BANK | CASH | WALLET
  bankName       String?  @map("bank_name")
  agency         String?
  accountNumber  String?  @map("account_number")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingDate    DateTime @default(now()) @map("opening_date")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  settlements FinancialSettlement[]
  statements  BankStatementLine[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("financial_accounts")
}

model FinancialCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  kind      String // REVENUE | DEDUCTION | COGS | VARIABLE_EXPENSE | OPERATING_EXPENSE | FINANCIAL | OTHER
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  titles FinancialTitle[]
  budgetLines BudgetLine[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("financial_categories")
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  titles FinancialTitle[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("cost_centers")
}

// Contas a pagar e a receber em uma só estrutura (direction). Baixas ficam em financial_settlements (imutáveis).
model FinancialTitle {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  direction        String // PAYABLE | RECEIVABLE
  status           String    @default("OPEN") // OPEN | PARTIAL | PAID | CANCELLED
  counterpartyKind String    @default("OTHER") @map("counterparty_kind") // SUPPLIER | CUSTOMER | SALESPERSON | MARKETPLACE | OTHER
  supplierId       String?   @map("supplier_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  salespersonId    String?   @map("salesperson_id") @db.Uuid
  connectionId     String?   @map("connection_id") @db.Uuid
  counterpartyName String?   @map("counterparty_name")
  description      String
  documentRef      String?   @map("document_ref")
  installmentNo    Int       @default(1) @map("installment_no")
  installmentTotal Int       @default(1) @map("installment_total")
  issueDate        DateTime? @map("issue_date")
  dueDate          DateTime  @map("due_date")
  amount           Decimal   @db.Decimal(14, 2)
  paidPrincipal    Decimal   @default(0) @map("paid_principal") @db.Decimal(14, 2)
  categoryId       String?   @map("category_id") @db.Uuid
  costCenterId     String?   @map("cost_center_id") @db.Uuid
  origin           String    @default("MANUAL") // MANUAL | FISCAL_XML | SALES_ORDER | COMMISSION | MARKETPLACE
  originRef        String?   @map("origin_ref")
  approvedById     String?   @map("approved_by_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason")
  notes            String?
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  category    FinancialCategory?    @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  costCenter  CostCenter?           @relation(fields: [tenantId, costCenterId], references: [tenantId, id])
  settlements FinancialSettlement[]
  negotiationLinks NegotiationTitle[]

  @@unique([tenantId, origin, originRef])
  @@unique([tenantId, id])
  @@index([tenantId, direction, status, dueDate])
  @@map("financial_titles")
}

model FinancialSettlement {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  titleId      String   @map("title_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  kind         String   @default("SETTLEMENT") // SETTLEMENT | REVERSAL
  amount       Decimal  @db.Decimal(14, 2) // dinheiro que entrou/saiu (negativo no estorno)
  principal    Decimal  @db.Decimal(14, 2) // parte que quita o título
  interest     Decimal  @default(0) @db.Decimal(14, 2)
  fine         Decimal  @default(0) @db.Decimal(14, 2)
  discount     Decimal  @default(0) @db.Decimal(14, 2)
  paidAt       DateTime @map("paid_at")
  reversalOfId String?  @unique @map("reversal_of_id") @db.Uuid
  note         String?
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  title   FinancialTitle   @relation(fields: [tenantId, titleId], references: [tenantId, id])
  account FinancialAccount @relation(fields: [tenantId, accountId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, accountId, paidAt])
  @@index([tenantId, titleId])
  @@map("financial_settlements")
}

model BankStatementLine {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  fitid        String
  postedAt     DateTime  @map("posted_at")
  amount       Decimal   @db.Decimal(14, 2) // com sinal: crédito + / débito −
  description  String
  settlementId String?   @map("settlement_id") @db.Uuid
  matchedAt    DateTime? @map("matched_at")
  matchedById  String?   @map("matched_by_id") @db.Uuid
  batch        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  account FinancialAccount @relation(fields: [tenantId, accountId], references: [tenantId, id])

  @@unique([accountId, fitid])
  @@unique([settlementId])
  @@index([tenantId, accountId, postedAt])
  @@map("bank_statement_lines")
}

// Linhas de relatório de liquidação do canal (importadas de arquivo): o dinheiro recebido ≠ total dos pedidos.
model MarketplaceSettlement {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  connectionId    String    @map("connection_id") @db.Uuid
  reportRef       String    @map("report_ref")
  externalOrderId String    @map("external_order_id")
  gross           Decimal   @db.Decimal(14, 2)
  commission      Decimal   @default(0) @db.Decimal(14, 2)
  fixedFee        Decimal   @default(0) @map("fixed_fee") @db.Decimal(14, 2)
  paymentFee      Decimal   @default(0) @map("payment_fee") @db.Decimal(14, 2)
  shipping        Decimal   @default(0) @db.Decimal(14, 2)
  adjustments     Decimal   @default(0) @db.Decimal(14, 2)
  refunds         Decimal   @default(0) @db.Decimal(14, 2)
  netReported     Decimal   @map("net_reported") @db.Decimal(14, 2)
  expectedDate    DateTime? @map("expected_date")
  receivedDate    DateTime? @map("received_date")
  status          String    @default("IMPORTED") // IMPORTED | UNLINKED | DIVERGENT | RECONCILED
  salesOrderId    String?   @map("sales_order_id") @db.Uuid
  titleId         String?   @map("title_id") @db.Uuid
  divergence      Json      @default("[]")
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([connectionId, reportRef, externalOrderId])
  @@index([tenantId, connectionId, status])
  @@map("marketplace_settlements")
}

model Packaging {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  name       String
  lengthMm   Int     @map("length_mm")
  widthMm    Int     @map("width_mm")
  heightMm   Int     @map("height_mm")
  maxWeightG Int     @map("max_weight_g")
  tareG      Int     @default(0) @map("tare_g")
  active     Boolean @default(true)

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("packagings")
}

model Shipment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  salesOrderId String    @map("sales_order_id") @db.Uuid
  carrier      String // CORREIOS | OUTRA
  service      String?
  trackingCode String?   @map("tracking_code")
  status       String    @default("PENDING") // PENDING | POSTED | IN_TRANSIT | DELIVERED | PROBLEM | CANCELLED
  packagingId  String?   @map("packaging_id") @db.Uuid
  weightG      Int?      @map("weight_g")
  lengthMm     Int?      @map("length_mm")
  widthMm      Int?      @map("width_mm")
  heightMm     Int?      @map("height_mm")
  cost         Decimal?  @db.Decimal(14, 2)
  postedAt     DateTime? @map("posted_at")
  deliveredAt  DateTime? @map("delivered_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  order  SalesOrder      @relation(fields: [tenantId, salesOrderId], references: [tenantId, id])
  events ShipmentEvent[]

  @@unique([tenantId, carrier, trackingCode])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("shipments")
}

model ShipmentEvent {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  shipmentId  String   @map("shipment_id") @db.Uuid
  occurredAt  DateTime @map("occurred_at")
  status      String
  description String
  location    String?
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [tenantId, shipmentId], references: [tenantId, id])

  @@index([tenantId, shipmentId, occurredAt])
  @@map("shipment_events")
}

model ReportExport {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  report      String
  format      String
  filters     Json     @default("{}")
  status      String   @default("PENDING") // PENDING | READY | FAILED
  rowCount    Int?     @map("row_count")
  fileName    String?  @map("file_name")
  content     Bytes?
  error       String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([tenantId, createdAt])
  @@map("report_exports")
}

// Histórico de assinatura do tenant. Escrita somente pelo administrador da plataforma (funções SECURITY DEFINER).
model Subscription {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  status      String // TRIALING | ACTIVE | PAST_DUE | CANCELLED | SUSPENDED
  periodStart DateTime  @default(now()) @map("period_start")
  periodEnd   DateTime? @map("period_end")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, createdAt])
  @@map("subscriptions")
}

// Administradores da plataforma (não pertencem a tenants). Concessão somente por script com acesso direto ao banco.
model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}

model PlatformAuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  tenantId    String?  @map("tenant_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("platform_audit_log")
}

// Identidade visual do tenant (logotipo). Um registro por tenant; só PNG/JPEG/WebP (SVG é recusado: pode carregar script).
model TenantBranding {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  logo        Bytes
  contentType String   @map("content_type")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_branding")
}

// Fotos do produto (as mesmas que vão ao anúncio). Guardadas no banco com limite de tamanho; ordem = position (0 = principal).
model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  position    Int      @default(0)
  contentType String   @map("content_type")
  content     Bytes
  width       Int
  height      Int
  bytes       Int
  alt         String?
  sourceUrl   String?  @map("source_url")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@index([tenantId, productId, position])
  @@map("product_images")
}

// Itens encontrados no canal (staging da importação "do canal para a base"). Não é produto: só vira produto/vínculo por ação do usuário.
model ChannelItem {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  connectionId  String   @map("connection_id") @db.Uuid
  externalId    String   @map("external_id")
  title         String?
  sku           String?
  gtin          String?
  price         Decimal? @db.Decimal(14, 2)
  quantity      Int?
  channelStatus String?  @map("channel_status")
  permalink     String?
  snapshot      Json     @default("{}")
  status        String   @default("NEW") // NEW | LINKED | IMPORTED | IGNORED
  productId     String?  @map("product_id") @db.Uuid
  matchedBy     String?  @map("matched_by") // SKU | GTIN
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  connection MarketplaceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id])
  product    Product?              @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([connectionId, externalId])
  @@index([tenantId, connectionId, status])
  @@map("channel_items")
}

// ── Roteirização e entrega pelo motorista (comprovante/canhoto obrigatório) ──

model Driver {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Acesso do motorista ao sistema (membro com o papel "Motorista").
  userId    String   @map("user_id") @db.Uuid
  name      String
  phone     String?
  vehicle   String?
  plate     String?
  cpf       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  routes DeliveryRoute[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@map("drivers")
}

model DeliveryRoute {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  number       Int
  routeDate    DateTime  @map("route_date") @db.Date
  driverId     String    @map("driver_id") @db.Uuid
  vehicleId    String?   @map("vehicle_id") @db.Uuid
  status       String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  notes        String?
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  driver Driver         @relation(fields: [tenantId, driverId], references: [tenantId, id])
  vehicle Vehicle? @relation(fields: [tenantId, vehicleId], references: [tenantId, id])
  stops  DeliveryStop[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, routeDate, status])
  @@index([tenantId, driverId, status])
  @@map("delivery_routes")
}

model DeliveryStop {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  routeId          String    @map("route_id") @db.Uuid
  salesOrderId     String    @map("sales_order_id") @db.Uuid
  sequence         Int
  status           String    @default("PENDING") // PENDING | DELIVERED | FAILED | CANCELLED
  customerName     String    @map("customer_name")
  customerPhone    String?   @map("customer_phone")
  addressText      String    @map("address_text")
  zipCode          String?   @map("zip_code")
  city             String?
  state            String?   @db.Char(2)
  deliveredAt      DateTime? @map("delivered_at")
  receiverName     String?   @map("receiver_name")
  receiverDocument String?   @map("receiver_document")
  notes            String?
  failureReason    String?   @map("failure_reason")
  lat              Decimal?  @db.Decimal(9, 6)
  lng              Decimal?  @db.Decimal(9, 6)
  accuracyM        Int?      @map("accuracy_m")
  resolvedById     String?   @map("resolved_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  route  DeliveryRoute   @relation(fields: [tenantId, routeId], references: [tenantId, id])
  order  SalesOrder      @relation(fields: [tenantId, salesOrderId], references: [tenantId, id])
  proofs DeliveryProof[]

  @@unique([tenantId, id])
  @@unique([tenantId, routeId, salesOrderId])
  @@index([tenantId, routeId, sequence])
  @@index([tenantId, salesOrderId])
  @@map("delivery_stops")
}

/// Foto do canhoto assinado (entrega) ou da ocorrência (não entregue). Guardada no banco, com limites; o hash impede reutilizar a mesma foto.
model DeliveryProof {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stopId      String   @map("stop_id") @db.Uuid
  kind        String // DELIVERY | FAILURE
  contentType String   @map("content_type")
  bytes       Int
  width       Int
  height      Int
  sha256      String
  content     Bytes
  takenById   String?  @map("taken_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  stop DeliveryStop @relation(fields: [tenantId, stopId], references: [tenantId, id])

  @@unique([tenantId, stopId, kind])
  @@unique([tenantId, sha256])
  @@map("delivery_proofs")
}

/// Inutilização de faixa de numeração (NF-e/NFC-e): fica registrada com o protocolo da SEFAZ.
model FiscalVoid {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  model           String
  series          Int
  fromNumber      Int      @map("from_number")
  toNumber        Int      @map("to_number")
  environment     String
  reason          String
  protocol        String
  statusCode      String   @map("status_code")
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, establishmentId, model, series])
  @@map("fiscal_voids")
}

/// Credenciais do provedor de emissão fiscal por estabelecimento (token cifrado; nunca devolvido pela API).
model FiscalProviderCredential {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  provider        String // FOCUS_NFE
  credsEnc        String   @map("creds_enc")
  /// Últimos caracteres de cada token, só para o usuário reconhecer o que está salvo.
  hintHomologacao String?  @map("hint_homologacao")
  hintProducao    String?  @map("hint_producao")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, establishmentId])
  @@map("fiscal_provider_credentials")
}

/// Negociação de dívida de cliente inadimplente: junta títulos vencidos em novas parcelas (boleto), com juros, multa e desconto.
model Negotiation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  number        Int
  customerId    String   @map("customer_id") @db.Uuid
  status        String   @default("ACTIVE") // ACTIVE | CANCELLED
  originalAmount Decimal @map("original_amount") @db.Decimal(14, 2)
  interest      Decimal  @default(0) @db.Decimal(14, 2)
  fine          Decimal  @default(0) @db.Decimal(14, 2)
  discount      Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(14, 2)
  installments  Int
  firstDueDate  DateTime @map("first_due_date") @db.Date
  intervalDays  Int      @default(30) @map("interval_days")
  notes         String?
  cancelReason  String?  @map("cancel_reason")
  cancelledAt   DateTime? @map("cancelled_at")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer           @relation(fields: [tenantId, customerId], references: [tenantId, id])
  titles   NegotiationTitle[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("negotiations")
}

/// Título vencido que entrou na negociação (o original é cancelado e volta a abrir se a negociação for desfeita).
model NegotiationTitle {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  negotiationId  String   @map("negotiation_id") @db.Uuid
  titleId        String   @map("title_id") @db.Uuid
  amount         Decimal  @db.Decimal(14, 2)
  dueDate        DateTime @map("due_date")
  createdAt      DateTime @default(now()) @map("created_at")

  negotiation Negotiation    @relation(fields: [tenantId, negotiationId], references: [tenantId, id])
  title       FinancialTitle @relation(fields: [tenantId, titleId], references: [tenantId, id])

  @@index([tenantId, titleId])
  @@index([tenantId, negotiationId])
  @@map("negotiation_titles")
}

/// Meta de vendas mensal por vendedor (período AAAA-MM).
model SalesGoal {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  salespersonId String   @map("salesperson_id") @db.Uuid
  period        String
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  salesperson Salesperson @relation(fields: [tenantId, salespersonId], references: [tenantId, id])

  @@unique([tenantId, salespersonId, period])
  @@map("sales_goals")
}

/// Orçamento financeiro mensal por categoria (lineKey = id da categoria, ou SALES para a receita de vendas).
model BudgetLine {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  lineKey    String   @map("line_key")
  categoryId String?  @map("category_id") @db.Uuid
  period     String
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category FinancialCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id])

  @@unique([tenantId, lineKey, period])
  @@map("budget_lines")
}

/// Orçamento (cotação) de venda: preços fixados, validade, e conversão em pedido.
model Quote {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  number        Int
  customerId    String   @map("customer_id") @db.Uuid
  salespersonId String?  @map("salesperson_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  status        String   @default("OPEN") // OPEN | CONVERTED | LOST
  validUntil    DateTime @map("valid_until") @db.Date
  paymentMethod String?  @map("payment_method")
  subtotal      Decimal  @default(0) @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @map("discount_total") @db.Decimal(14, 2)
  shipping      Decimal  @default(0) @db.Decimal(14, 2)
  total         Decimal  @default(0) @db.Decimal(14, 2)
  notes         String?
  orderId       String?  @map("order_id") @db.Uuid
  lostReason    String?  @map("lost_reason")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id])
  items    QuoteItem[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  discountPct Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  total       Decimal @db.Decimal(14, 2)

  quote   Quote   @relation(fields: [tenantId, quoteId], references: [tenantId, id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([quoteId, productId])
  @@map("quote_items")
}

/// Lote de um produto em um depósito (quantidade física e validade). Só existe para produtos com controle de lote.
model StockLot {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  code       String
  expiresAt  DateTime? @map("expires_at") @db.Date
  onHand     Int       @default(0) @map("on_hand")
  receivedAt DateTime  @default(now()) @map("received_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id])
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  movements StockLotMovement[]
  locationItems StockLocationItem[]

  @@unique([tenantId, productId, warehouseId, code])
  @@unique([tenantId, id])
  @@index([tenantId, productId, warehouseId, expiresAt])
  @@map("stock_lots")
}

/// De onde (ou para onde) cada movimento de estoque tirou (ou pôs) quantidade: rastreabilidade por lote.
model StockLotMovement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  movementId String   @map("movement_id") @db.Uuid
  lotId      String   @map("lot_id") @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")

  lot StockLot @relation(fields: [tenantId, lotId], references: [tenantId, id])

  @@index([tenantId, movementId])
  @@index([tenantId, lotId])
  @@map("stock_lot_movements")
}

/// Endereço dentro do depósito (ex.: A-01-02 = rua A, prédio 01, nível 02).
model WarehouseLocation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  code        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  items     StockLocationItem[]

  @@unique([tenantId, warehouseId, code])
  @@unique([tenantId, id])
  @@map("warehouse_locations")
}

/// Quantidade de um produto (e lote) guardada em um endereço. A soma dos endereços nunca passa do saldo físico do depósito.
model StockLocationItem {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  lotId      String? @map("lot_id") @db.Uuid
  lotKey     String  @default("NONE") @map("lot_key")
  quantity   Int

  location WarehouseLocation @relation(fields: [tenantId, locationId], references: [tenantId, id])
  product  Product           @relation(fields: [tenantId, productId], references: [tenantId, id])
  lot      StockLot?         @relation(fields: [tenantId, lotId], references: [tenantId, id])

  @@unique([tenantId, locationId, productId, lotKey])
  @@index([tenantId, productId])
  @@map("stock_location_items")
}

/// Conferência de um pedido na separação (leitura de códigos de barras): resultado e divergências.
model OrderCheck {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  status      String // OK | DIVERGENT
  items       Json     @default("[]")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  order SalesOrder @relation(fields: [tenantId, orderId], references: [tenantId, id])

  @@index([tenantId, orderId])
  @@map("order_checks")
}

/// Cotação de compra entre fornecedores (RFQ): itens a comprar, propostas por fornecedor e as ordens geradas.
model RfqRequest {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  number      Int
  warehouseId String    @map("warehouse_id") @db.Uuid
  status      String    @default("OPEN") // OPEN | CLOSED | CANCELLED
  neededBy    DateTime? @map("needed_by") @db.Date
  notes       String?
  orderIds    Json      @default("[]") @map("order_ids")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  closedAt    DateTime? @map("closed_at")

  items     RfqItem[]
  suppliers RfqSupplier[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("rfq_requests")
}

model RfqItem {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  rfqId     String @map("rfq_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int

  rfq     RfqRequest @relation(fields: [tenantId, rfqId], references: [tenantId, id])
  product Product    @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([rfqId, productId])
  @@unique([tenantId, id])
  @@map("rfq_items")
}

model RfqSupplier {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  rfqId         String    @map("rfq_id") @db.Uuid
  supplierId    String    @map("supplier_id") @db.Uuid
  leadTimeDays  Int?      @map("lead_time_days")
  freight       Decimal   @default(0) @db.Decimal(14, 2)
  paymentTerms  String?   @map("payment_terms")
  notes         String?
  respondedAt   DateTime? @map("responded_at")

  rfq      RfqRequest @relation(fields: [tenantId, rfqId], references: [tenantId, id])
  supplier Supplier   @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  prices   RfqPrice[]

  @@unique([rfqId, supplierId])
  @@unique([tenantId, id])
  @@map("rfq_suppliers")
}

model RfqPrice {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  rfqSupplierId String  @map("rfq_supplier_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  unitCost      Decimal @map("unit_cost") @db.Decimal(14, 4)

  rfqSupplier RfqSupplier @relation(fields: [tenantId, rfqSupplierId], references: [tenantId, id])

  @@unique([rfqSupplierId, productId])
  @@map("rfq_prices")
}

/// Veículo da frota (capacidade para conferir a carga de cada viagem).
model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  plate       String
  description String
  kind        String   @default("VAN") // MOTORCYCLE | VAN | TRUCK | OTHER
  capacityKg  Int?     @map("capacity_kg")
  /// Dados exigidos pelo MDF-e rodoviário.
  tareKg      Int?     @map("tare_kg")
  plateUf     String?  @map("plate_uf") @db.Char(2)
  renavam     String?
  /// Tipo de carroceria (tpCar): 00 não aplicável, 01 aberta, 02 fechada/baú, 03 graneleira, 04 porta-contêiner, 05 sider.
  bodyCode    String   @default("00") @map("body_code")
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  routes DeliveryRoute[]
  costs  FleetCost[]
  mdfes  MdfeDocument[]

  @@unique([tenantId, plate])
  @@unique([tenantId, id])
  @@map("vehicles")
}

/// Custo de operação da frota (combustível, pedágio, manutenção, motorista...), do veículo e, se for o caso, de uma viagem (rota).
model FleetCost {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  routeId   String?  @map("route_id") @db.Uuid
  kind      String // FUEL | TOLL | MAINTENANCE | DRIVER | INSURANCE | OTHER
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  note      String?
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id])

  @@index([tenantId, vehicleId, date])
  @@index([tenantId, routeId])
  @@map("fleet_costs")
}

/// Evento fiscal enviado à SEFAZ para uma nota: carta de correção (CC-e) ou manifestação do destinatário.
model FiscalEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  kind        String // CCE | MANIFEST
  tpEvento    String   @map("tp_evento")
  seq         Int      @default(1)
  text        String?
  status      String // REGISTERED | REJECTED
  statusCode  String?  @map("status_code")
  protocol    String?
  message     String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  document FiscalDocument @relation(fields: [tenantId, documentId], references: [tenantId, id])

  @@index([tenantId, documentId, tpEvento, seq])
  @@map("fiscal_events")
}

/// MDF-e (Manifesto Eletrônico de Documentos Fiscais, modal rodoviário) de uma viagem. O XML autorizado é a prova; o resto é cópia para consulta.
model MdfeDocument {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  routeId         String    @map("route_id") @db.Uuid
  vehicleId       String?   @map("vehicle_id") @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  status          String    @default("DRAFT") // DRAFT | TRANSMITTING | PENDING_CONSULT | AUTHORIZED | REJECTED | CLOSED | CANCELLED
  environment     String    @default("HOMOLOGACAO")
  series          Int?
  number          Int?
  accessKey       String?   @map("access_key")
  issuedAt        DateTime? @map("issued_at")
  protocol        String?
  closeProtocol   String?   @map("close_protocol")
  cancelProtocol  String?   @map("cancel_protocol")
  statusCode      String?   @map("status_code")
  statusMessage   String?   @map("status_message")
  payload         Json      @default("{}")
  issues          Json      @default("[]")
  signedXml       String?   @map("signed_xml")
  authorizedXml   String?   @map("authorized_xml")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  vehicle Vehicle? @relation(fields: [tenantId, vehicleId], references: [tenantId, id])

  @@unique([tenantId, accessKey])
  @@unique([tenantId, id])
  @@index([tenantId, routeId])
  @@index([tenantId, status])
  @@map("mdfe_documents")
}

/// Redefinição de senha: só o hash do token é guardado; vale 1 hora e uma única vez.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Convite de usuário por e-mail. O token é "<tenantId>.<aleatório>"; só o hash fica no banco.
model UserInvite {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String
  name        String
  roleId      String    @map("role_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  invitedById String?   @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, email])
  @@map("user_invites")
}

/// Conexão do WhatsApp da empresa pela Evolution API (uma instância por empresa, pareada por QR code).
model WhatsappConnection {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @unique @map("tenant_id") @db.Uuid
  instanceName String    @unique @map("instance_name")
  status       String    @default("DISCONNECTED") // DISCONNECTED | CONNECTING | CONNECTED
  phone        String?
  lastError    String?   @map("last_error")
  connectedAt  DateTime? @map("connected_at")
  /// A empresa quer o WhatsApp sempre ligado: o vigia reconecta sozinho se a sessão cair (só o QR code novo exige a pessoa).
  wantConnected     Boolean   @default(false) @map("want_connected")
  reconnectAttempts Int       @default(0) @map("reconnect_attempts")
  lastCheckedAt     DateTime? @map("last_checked_at")
  lostNotifiedAt    DateTime? @map("lost_notified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("whatsapp_connections")
}

/// Avisos automáticos por tipo (INVOICE_DUE, ORDER_STATUS, COLLECTION). Tudo começa desligado.
model NotificationRule {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  type            String
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  whatsappEnabled Boolean  @default(false) @map("whatsapp_enabled")
  daysBefore      Int      @default(2) @map("days_before")
  minOverdueDays  Int      @default(1) @map("min_overdue_days")
  repeatEveryDays Int      @default(7) @map("repeat_every_days")
  orderStatuses   Json     @default("[\"CONFIRMED\",\"SHIPPED\",\"DELIVERED\"]") @map("order_statuses")
  subject         String?
  body            String?
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, type])
  @@map("notification_rules")
}

/// Fila e histórico dos avisos. dedupeKey impede enviar o mesmo aviso duas vezes pelo mesmo canal.
model NotificationLog {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  type       String
  channel    String // EMAIL | WHATSAPP
  recipient  String
  subject    String?
  body       String
  status     String    @default("QUEUED") // QUEUED | SENT | FAILED | SKIPPED
  error      String?
  attempts   Int       @default(0)
  customerId String?   @map("customer_id") @db.Uuid
  refType    String?   @map("ref_type")
  refId      String?   @map("ref_id")
  dedupeKey  String    @map("dedupe_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  sentAt     DateTime? @map("sent_at")

  @@unique([tenantId, dedupeKey, channel])
  @@index([tenantId, status, createdAt])
  @@map("notification_logs")
}

/// Faixa de bônus por atingimento da meta mensal (maior faixa atingida vale; não soma).
model GoalBonusTier {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  minPct      Decimal  @map("min_pct") @db.Decimal(7, 2)
  kind        String // PERCENT (sobre o vendido no mês) | FIXED
  percent     Decimal? @db.Decimal(7, 4)
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(14, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, active])
  @@map("goal_bonus_tiers")
}

/// Bônus apurado do vendedor no mês fechado (congelado: devoluções posteriores não o alteram).
model GoalBonus {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  salespersonId  String    @map("salesperson_id") @db.Uuid
  period         String
  goalAmount     Decimal   @map("goal_amount") @db.Decimal(14, 2)
  achieved       Decimal   @db.Decimal(14, 2)
  attainmentPct  Decimal   @map("attainment_pct") @db.Decimal(9, 2)
  tierId         String?   @map("tier_id") @db.Uuid
  tierName       String?   @map("tier_name")
  amount         Decimal   @db.Decimal(14, 2)
  status         String    @default("EARNED") // EARNED | PAID
  payoutTitleId  String?   @map("payout_title_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  paidAt         DateTime? @map("paid_at")

  @@unique([tenantId, salespersonId, period])
  @@map("goal_bonuses")
}

/// Impostos federais da empresa (Simples/Presumido/Real/MEI, PIS/COFINS e opções da Lei 12.741). Valores digitados e validados pelo contador;
/// o sistema não traz alíquotas prontas.
model FederalTaxConfig {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  companyId          String     @map("company_id") @db.Uuid
  regime             TaxRegime
  pisRate            Decimal    @map("pis_rate") @db.Decimal(7, 4)
  cofinsRate         Decimal    @map("cofins_rate") @db.Decimal(7, 4)
  scArticle          String?    @map("sc_article")
  showTotalTaxes     Boolean    @default(false) @map("show_total_taxes")
  presumedCredit     Boolean    @default(false) @map("presumed_credit")
  exceededSublimit   Boolean    @default(false) @map("exceeded_sublimit")
  /// Lista por UF de destino: [{ uf, cst, ratePct? }] para ICMS e [{ uf, cst, classification }] para IBS/CBS.
  icmsByUf           Json       @default("[]") @map("icms_by_uf")
  ibsCbsByUf         Json       @default("[]") @map("ibs_cbs_by_uf")
  updatedById        String?    @map("updated_by_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, companyId])
  @@map("federal_tax_configs")
}

/// Foto de perfil do usuário (a mesma em todas as empresas dele). Imagem já reduzida pela tela; limite de 512 KB.
model UserAvatar {
  userId      String   @id @map("user_id") @db.Uuid
  content     Bytes
  contentType String   @map("content_type")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}
