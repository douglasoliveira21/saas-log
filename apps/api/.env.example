# Copie para apps/api/.env — NUNCA versione segredos reais.
APP_NAME=DistribuiHub ERP
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Conexão de runtime: papel dh_app (sujeito a RLS). Senha de desenvolvimento apenas.
DATABASE_URL=postgresql://dh_app:dh_app_dev@localhost:5439/distribuihub
# Conexão de migrações/administração (dono do schema).
DIRECT_URL=postgresql://postgres@localhost:5439/distribuihub
# Senha aplicada ao papel dh_app por `npm run db:setup`.
DH_APP_PASSWORD=dh_app_dev

# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
COOKIE_SECURE=false

# Somente desenvolvimento: senha dos usuários de demonstração.
SEED_PASSWORD=Demo@123456

# Chave mestra das credenciais de integrações (32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
# Rotação: ao trocar a chave, mova a antiga para cá (as credenciais são relidas e regravadas com a nova).
CREDENTIALS_KEY_PREVIOUS=
# Worker de filas no mesmo processo do API (false para rodar só o API).
WORKER_ENABLED=true
# Habilita o conector Sandbox (testes). Nunca em produção.
ENABLE_SANDBOX_CONNECTOR=false

# ── Mercado Livre (aplicativo criado em Mercado Livre Developers; ver docs/MARKETPLACE-INTEGRATIONS.md) ──
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Token que você coloca no final da URL de notificações do aplicativo: <WEB_ORIGIN>/api/webhooks/providers/mercado_livre/<ML_WEBHOOK_TOKEN>
ML_WEBHOOK_TOKEN=
# Defina true somente se o PKCE estiver habilitado nas configurações do aplicativo.
ML_USE_PKCE=false

# ── Fase 8: operação ──
# Habilita GET /api/metrics (Prometheus) com `Authorization: Bearer <token>`. Vazio = endpoint desligado (404).
METRICS_TOKEN=
# Chave (32 bytes base64) para cifrar backups com `npm run backup` (AES-256-GCM). Guarde FORA do local dos backups.
BACKUP_KEY=
# Diretório dos binários do PostgreSQL (pg_dump/pg_restore) quando não estiverem no PATH.
PG_BIN=

# Consulta de CNPJ/CEP (padrões abaixo; só altere para apontar a um espelho/proxy próprio)
# LOOKUP_BRASILAPI_BASE=https://brasilapi.com.br
# LOOKUP_VIACEP_BASE=https://viacep.com.br

# Publicar anúncios no Mercado Livre cria anúncios REAIS e ainda não foi validado com conta real: desligado por padrão.
# ML_PUBLISH_ENABLED=false

# ── Magalu (aplicativo criado com a ferramenta idm em developers.magalu.com; ver docs/MARKETPLACE-INTEGRATIONS.md) ──
MAGALU_CLIENT_ID=
MAGALU_CLIENT_SECRET=
# Escopos pedidos no consentimento (padrão: leitura de pedidos, entregas, SKUs, preços e estoques).
# MAGALU_SCOPES=open:order-order-seller:read open:order-delivery-seller:read open:portfolio-skus-seller:read open:portfolio-prices-seller:read open:portfolio-stocks-seller:read
# Status do pedido (como o Magalu devolve, separados por vírgula) que significam PAGO. Vazio = nenhum pedido é importado (por segurança).
MAGALU_PAID_STATUSES=
# MAGALU_CANCELLED_STATUSES=canceled,cancelled
